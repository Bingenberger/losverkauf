# Beispiel für manuell geprüften nativen Betrieb; Compose nutzt einzelne Secretdateien.
SECRET_KEY_FILE=/privater/pfad/session-key
ELTERN_TOKEN_FILE=/privater/pfad/parent-token
ADMIN_USERNAME_FILE=/privater/pfad/admin-name
ADMIN_PASSWORD_HASH_FILE=/privater/pfad/admin-hash
DB_PATH=/opt/losverkauf/data/losverkauf.db
GEOJSON_PATH=/opt/losverkauf/data/maps/bezirke.geojson
BASE_URL=https://lose.example.invalid
PROXY_IPS=127.0.0.1
TITEL=Losverkauf
SESSION_COOKIE_SECURE=1

# Leer = private Maildateien. Im Test ausschließlich lokaler Sink ohne Upstream.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SICHERHEIT=keine
SMTP_TIMEOUT_S=5
SMTP_USER=
SMTP_PASSWORD_FILE=
MAIL_FROM=Losverkauf <noreply@example.invalid>
MAIL_REPLY_TO=
TILE_URL=
