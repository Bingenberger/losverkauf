SECRET_KEY=BITTE_LANGEN_ZUFALLSSTRING_EINTRAGEN
ELTERN_TOKEN=BITTE_TOKEN_EINTRAGEN
ADMIN_PASSWORD=BITTE_PASSWORT_EINTRAGEN
DB_PATH=/opt/losverkauf/data/losverkauf.db
TITEL=Losverkauf St. Martin 2026
# 1 = Session-Cookie nur über https (Standard im Betrieb mit TLS); 0 nur für reinen http-Betrieb
SESSION_COOKIE_SECURE=1

# Mailversand (Eingangsbestätigung + feste Zuteilung).
# Ohne SMTP_HOST läuft der Testbetrieb: Mails landen nur als .eml-Datei unter data/mails/.
SMTP_HOST=
SMTP_PORT=587
# starttls (Port 587) | ssl (Port 465) | keine
SMTP_SICHERHEIT=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Losverkauf St. Martin <lose@example.de>
MAIL_REPLY_TO=
